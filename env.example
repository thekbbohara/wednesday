# Wednesday environment. Copy to .env (cp env.example .env) and fill only what you need.
# An unset or empty key uses the default shown in the comment, unless noted.
# Settings saved from the web UI (<data>/settings.json) win over these.
#
# Legacy names: every WEDNESDAY_<X> below is also read as MAJORDOMO_<X> when the
# WEDNESDAY_ name is unset (e.g. MAJORDOMO_MODEL). Prefer the WEDNESDAY_ names;
# a WEDNESDAY_ key that is present but empty hides its MAJORDOMO_ alias.
# Keys marked "empty = ..." change behavior when present but empty, so they stay
# commented out until you set them.

# --- Identity ---------------------------------------------------------------
# Display name in the UI, prompts and agent briefs. Default: Wednesday.
ASSISTANT_NAME=

# --- Data -------------------------------------------------------------------
# Memory folder (memory.db, settings.json, secrets/, worktrees/). Default: ~/.wednesday,
# or a legacy ~/.jarvis / ~/.majordomo when ~/.wednesday does not exist (one warning).
# Docker always uses /data (see WEDNESDAY_DATA below).
WEDNESDAY_DATA_DIR=
# Folder with keys.json (API keys saved on the Settings page). Default: <data>/secrets.
WEDNESDAY_SECRETS_DIR=

# --- Web server -------------------------------------------------------------
# Listen address and port. Default: 127.0.0.1 and 4788. In Docker, these instead
# set the host side of the port mapping (the container always listens on 4788).
WEDNESDAY_BIND=
WEDNESDAY_PORT=
# Generic fallbacks, used when WEDNESDAY_BIND / WEDNESDAY_PORT are unset.
HOST=
PORT=
# Shared secret for the web chat and agent hooks. Set it before binding anything but 127.0.0.1.
WEDNESDAY_TOKEN=
# Private tmux socket for worker agents. Default: majordomo.
WEDNESDAY_TMUX_SOCKET=

# --- Captain ----------------------------------------------------------------
# Claude Code binary. Default: claude.
WEDNESDAY_CLAUDE_BIN=
# Claude account folder for the captain, sleep and workers. Default: the CLI's own login (~/.claude).
CLAUDE_CONFIG_DIR=
# Captain model. Default: opus.
WEDNESDAY_MODEL=
# Fallback chain on usage limits, comma-separated, e.g. claude:~/.claude-2,codex,kimi.
# Codex-as-captain runs with approvals and sandbox bypassed (see README).
WEDNESDAY_FALLBACKS=
# Minutes a usage-limited provider is skipped before it is retried. Default: 180.
WEDNESDAY_LIMIT_COOLDOWN_MIN=
# Rotate the session past this fraction of the context window. Default: 0.4.
WEDNESDAY_ROTATE_AT=
# Backstop: rotate after this many turns in one session. Default: 40.
WEDNESDAY_MAX_TURNS=
# Seconds before a captain turn is abandoned. Default: 600.
WEDNESDAY_TURN_TIMEOUT=
# Captain system prompt. Default: prompts/captain.md.
WEDNESDAY_PROMPT_FILE=
# Built-in tools for live checks, comma-separated; empty = none. Memory tools are always on.
# Default: Read,Glob,Grep,Bash(git status:*),Bash(git log:*),Bash(git diff:*)
# WEDNESDAY_ALLOWED_TOOLS=

# --- Recall -----------------------------------------------------------------
# Facts and ledger hits recalled per owner message. Default: 6 and 4.
WEDNESDAY_RECALL_FACTS=
WEDNESDAY_RECALL_LEDGER=
# Recent conversation carried into a fresh session: messages and chars. Default: 12 and 12000.
WEDNESDAY_TAIL_MESSAGES=
WEDNESDAY_TAIL_CHARS=
# Hard cap on Now, in chars. Default: 8000.
WEDNESDAY_NOW_BUDGET_CHARS=
# Local CPU embedding model for meaning search ("crash" finds "freeze"), fused with
# keyword search. Downloaded once (~35 MB) to <data>/models; vectors live in
# <data>/memory-vec.db, rebuilt at low priority. "off" = keyword search only.
# Default: Xenova/bge-small-en-v1.5.
WEDNESDAY_EMBED_MODEL=

# --- Nightly sleep ----------------------------------------------------------
# Local time HH:MM (24h); empty = sleep turned off. Default: 04:00.
# WEDNESDAY_SLEEP_AT=
# Sleep model. Default: haiku.
WEDNESDAY_SLEEP_MODEL=
# Sleep prompt. Default: prompts/sleep.md.
WEDNESDAY_SLEEP_PROMPT_FILE=
# Fact extraction between sleeps (same model, facts and project pages only, no digest):
# runs once this many conversation entries wait, or once the oldest is this many
# minutes old. 0 = only the nightly sleep. Default: 30 and 60.
WEDNESDAY_EXTRACT_EVERY=
WEDNESDAY_EXTRACT_MINUTES=

# --- Other agent CLIs (read for logins, usage and credits) ------------------
# Default: ~/.codex
CODEX_HOME=
# Default: ~/.kimi-code
KIMI_CODE_HOME=
# Default: ~/.pi/agent
PI_CODING_AGENT_DIR=
# opencode lives in <this>/opencode. Default: ~/.local/share
XDG_DATA_HOME=

# --- Set by Wednesday for its children; do not set by hand ------------------
# The MCP memory server (npm run mcp) needs WEDNESDAY_DB; the captain passes all of these.
# WEDNESDAY_DB=
# WEDNESDAY_SESSION=
# Worker agents' hooks report to WEDNESDAY_URL as WEDNESDAY_AGENT.
# WEDNESDAY_URL=
# WEDNESDAY_AGENT=

# --- Bundled skills (skills/osint scripts, run by agents) -------------------
# Python for install-osint.sh. Default: python3.
PYTHON=
# Any value marks Telegram / WhatsApp as connected in diagnose.sh.
TELEGRAM_API_ID=
WHATSAPP_BRIDGE=

# --- Docker Compose ---------------------------------------------------------
# Host user, so mounted files stay yours (`id -u` / `id -g`). Default: 1000.
UID=
GID=
# Memory volume or host folder mounted at /data. Default: the majordomo-data volume.
# For a host folder, create it first (mkdir -p data) so it is owned by you, not root.
WEDNESDAY_DATA=
# Folder with the repos agents work on, mounted at the same path. Default: ~/projects.
PROJECTS_DIR=
# Legacy Compose names, read only when the WEDNESDAY_ name is unset.
MAJORDOMO_DATA=
MAJORDOMO_BIND=
MAJORDOMO_PORT=

# --- Tests and dev tools ----------------------------------------------------
# 1 runs the live tests against the real Claude CLI (costs a few cents).
WEDNESDAY_LIVE=
# Model for the live tests. Default: haiku.
WEDNESDAY_LIVE_MODEL=
# test/demo-server.ts: scripted reply delay in ms. Default: 1500.
DEMO_DELAY_MS=
# test/t50-review-preview.ts port. Default: 4808.
T50_REVIEW_PORT=
