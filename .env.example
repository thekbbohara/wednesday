# Host user, so mounted files stay yours (`id -u` / `id -g`).
UID=1000
GID=1000

# Where the memory lives. Default: the jarvis-data volume. For a host folder,
# create it first (mkdir -p data) so it is owned by you, not root.
# JARVIS_DATA=./data

# Folder with the repos agents work on, mounted at the same path inside the container.
# PROJECTS_DIR=/home/you/projects

# Web chat address on the host. Set JARVIS_TOKEN before binding anything but 127.0.0.1.
# JARVIS_BIND=127.0.0.1
# JARVIS_PORT=4788
# JARVIS_TOKEN=

# Captain model and rotation (see README for all options).
JARVIS_MODEL=opus
JARVIS_ROTATE_AT=0.4
JARVIS_MAX_TURNS=40
