# Host user, so mounted files stay yours (`id -u` / `id -g`).
UID=1000
GID=1000

# Where the memory lives. Default: the majordomo-data volume. For a host folder,
# create it first (mkdir -p data) so it is owned by you, not root.
# WEDNESDAY_DATA=./data

# Folder with the repos agents work on, mounted at the same path inside the container.
# PROJECTS_DIR=/home/you/projects

# Web chat address on the host. Set WEDNESDAY_TOKEN before binding anything but 127.0.0.1.
# WEDNESDAY_BIND=127.0.0.1
# WEDNESDAY_PORT=4788
# WEDNESDAY_TOKEN=

# What the assistant calls itself (shown in the UI, prompts and agent briefs).
ASSISTANT_NAME=Wednesday

# Captain fallback chain: if the selected engine hits its usage limit, the
# captain switches to the next provider (another Claude account, Codex or Kimi), and
# returns to the primary after a cooldown. Comma-separated.
#   claude:<config dir> = another Claude account; codex[:model] / kimi[:model] = their CLIs.
# Codex-as-captain runs with its approvals and sandbox bypassed (see README).
# WEDNESDAY_FALLBACKS=claude:~/.claude-2,codex,kimi

# Captain model and rotation (see README for all options).
WEDNESDAY_MODEL=opus
WEDNESDAY_ROTATE_AT=0.4
WEDNESDAY_MAX_TURNS=40
