[Unit]
Description=Wednesday Telegram gateway (the bot's only getUpdates consumer: owner chat, ClipCrew clips, Eagle Eye commands)
Conflicts=majordomo-telegram.service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/kb26/.jarvis/worktrees/tggateway
ExecStart=/home/kb26/.local/share/pi-node/node-v22.23.2-linux-x64/bin/node --env-file-if-exists=/home/kb26/kb/jarvis/.env --disable-warning=ExperimentalWarning /home/kb26/.jarvis/worktrees/tggateway/src/telegram/gateway.ts
Environment="TELEGRAM_ENV_FILE=/home/kb26/.jarvis/work/eagle-eye/.env"
Environment="TELEGRAM_WHISPER_PYTHON=/home/kb26/kb/clipcrew/.venv/bin/python"
Environment="MAJORDOMO_URL=http://127.0.0.1:4788"
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
